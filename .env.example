# OpenAI API
OPENAI_API_KEY=sk-...

# Servidor MCP
MCP_SERVER_URL=http://localhost:8765/mcp
MCP_TIMEOUT=15

# Banco de dados
DATABASE_PATH=data/grafo.db
MEMORIA_PATH=data/memoria.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/agentes.log

# Painel Streamlit
STREAMLIT_PORT=8501
STREAMLIT_HOST=localhost

# Portal (Playwright)
PORTAL_URL=http://localhost:3000
PORTAL_USERNAME=admin
PORTAL_PASSWORD=

# Limites de custo
CUSTO_MAX_RODADA=0.50
CHAMADAS_MAX_EVENTO=5

# Relógio simulado
RELATORIO_SIMULADO=true
